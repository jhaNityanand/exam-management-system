APP_NAME="Exam Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=exam-management-system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): SESSION_SECURE_COOKIE=true
# SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting without a long-running worker: use sync
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional — also configurable in Admin → Settings → Email Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Optional AdSense / analytics (leave empty until configured)
ADSENSE_CLIENT_ID=
ADS_GA_MEASUREMENT_ID=
PINTEREST_DOMAIN_VERIFY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GALLERY_DISK=public
GALLERY_MAX_IMAGE_KB=5120
GALLERY_MAX_VIDEO_KB=51200
GALLERY_MAX_FILE_KB=20480

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# LLM / AI SEO Management (Managed via Admin → Settings → LLM Management)
# ---------------------------------------------------------------------------
# All LLM provider accounts (Mistral AI, Groq, Google Gemini, OpenRouter) are managed
# completely via the Database UI at Admin → Settings → LLM Management.
LLM_TIMEOUT=60
LLM_RETRY=2
LLM_QUEUE_SIZE=50
LLM_BATCH_SIZE=6
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096
LLM_SEO_SCHEDULE_ENABLED=true
LLM_SEO_EVERY_MINUTES=5

# ---------------------------------------------------------------------------
# Production checklist (Hostinger / shared hosting)
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=error
# APP_URL=https://your-domain.com
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# QUEUE_CONNECTION=database
# Document root MUST be /public (or rely on root .htaccess rewrite)
# Run: php artisan storage:link && php artisan migrate --force && php artisan optimize
# Cron: * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
# Queue worker: php artisan queue:work --queue=llm-seo,default

